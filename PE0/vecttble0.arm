;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  for direct vector method
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;*******************************************************************************
; vector section
;*******************************************************************************
	.section .isr_vector
	;.align	1024

	; definition of vector table 
	.globl	__isr_vector
__isr_vector:
    .word	(__ghsend_stack - 4)  ; Initial SP value
	.word	(__start + 1)         ; Reset Handler 
	.word	(_dummy + 1)          ; NMI Handler 
	.word	(_dummy + 1)          ; Hard Fault Handler 
	.word	(_dummy + 1)          ; MPU Fault Handler 
	.word	(_dummy + 1)          ; Bus Fault Handler 
	.word	(_dummy + 1)          ; Usage Fault Handler 
	.word	(_dummy + 1)          ; Reserved 
	.word	(_dummy + 1)          ; Reserved 
	.word	(_dummy + 1)          ; Reserved 
	.word	(_dummy + 1)          ; Reserved 
	.word	(_dummy + 1)          ; SVCall Handler 
	.word	(_dummy + 1)          ; Debug Monitor Handler 
	.word	(_dummy + 1)          ; Reserved 
	.word	(_dummy + 1)          ; PendSV Handler 
	.word	(_dummy + 1)          ; SysTick Handler 
 



    .section ".text",.text
    .align 4
_dummy:
    NOP
	B  _dummy








; EOF 





