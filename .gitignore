# =========================================================
#  Green Hills (MULTI / gbuild) 프로젝트용 .gitignore
#  소스(.c/.h/.s), 프로젝트 파일(.gpj), 링커 스크립트(.ld) 등은 추적됨
# =========================================================

# ---- 빌드 출력 폴더 (프로젝트 설정에 맞게 이름 확인) ----
obj/
objs/
Debug/
Release/
build/
out/
output/

# ---- 컴파일 중간 산출물 ----
*.o
*.obj
*.d
*.dep
*.lst
*.i

# ---- Green Hills 디버그/링크 정보 파일 ----
*.dbo
*.dla
*.dle
*.dnm
*.inf
*.ti
*.si
*.graph
*.gpj.bak
*.ael

# ---- 링크 결과물 ----
*.elf
*.out
*.abs
*.run
*.map
*.mem

# ---- 다운로드용 이미지 (배포용으로 보관해야 하면 아래 줄 삭제) ----
*.hex
*.bin
*.srec
*.mot
*.s19

# ---- 라이브러리 빌드 산출물 ----
# 직접 빌드하는 라이브러리만 무시. 벤더가 준 .a/.lib를 커밋해야 하면 주석 처리
*.a
*.lib

# ---- MULTI IDE / 디버거 개인 설정 ----
*.mbs
*.bak
*.tmp
*.log

# ---- 에디터 ----
.vscode/
.idea/
*.swp
*~

# ---- Windows ----
Thumbs.db
desktop.ini
